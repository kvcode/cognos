{
  // ═══════════════════════════════════════════════════════════════════════════
  // ROOT-LEVEL SETTINGS
  // ═══════════════════════════════════════════════════════════════════════════

  "selectFirstGroupExpanded": true,           // OPTIONAL (Boolean) - If true, auto-expands the first button group on load.
                                               // Overridden by each group's own "defaultExpanded" if set.

  // ═══════════════════════════════════════════════════════════════════════════
  // PRESETS - Quick-load parameter combinations
  // ═══════════════════════════════════════════════════════════════════════════

  "presets": [                                 // OPTIONAL (Array) - Defines preset buttons shown above the groups.
                                               // Each preset auto-creates cards for the listed parameters.
    {
      "id": "preset_basic_product",            // REQUIRED (String) - Unique identifier for this preset.
      "label": "Basic Product Filter",         // REQUIRED (String) - Fallback display label if locale not matched.
      "labels": {                              // OPTIONAL (Object) - Localized labels keyed by 2-letter locale code.
        "de": "Basis Produktfilter",
        "en": "Basic Product Filter"
      },
      "description": "Load common product filter parameters",  // OPTIONAL (String) - Tooltip/description for the preset button.
      "parameters": [                          // REQUIRED (Array) - List of paramNames to auto-load when preset is clicked.
        { "paramName": "P_ProdCat_L1" },       // Must match a button's paramName in buttonGroups.
        { "paramName": "P_Region" }
      ]
    }
  ],

  // ═══════════════════════════════════════════════════════════════════════════
  // BUTTON GROUPS - Main configuration structure
  // ═══════════════════════════════════════════════════════════════════════════

  "buttonGroups": [                            // REQUIRED (Array) - Top-level array of button groups.
                                               // Each group becomes a collapsible section in the left pane.

    // ─────────────────────────────────────────────────────────────────────────
    // GROUP 1: Product (PR)
    // Contains: 1 subgroup (3 buttons) + 3 standalone buttons
    // ─────────────────────────────────────────────────────────────────────────
    {
      "groupLabel": "Product (PR)",            // REQUIRED (String) - Fallback label for the group header.
      "groupLabels": {                         // OPTIONAL (Object) - Localized group labels by 2-letter locale.
        "de": "Produkt (PR)",
        "en": "Product (PR)"
      },
      "groupIcon": "<svg>...</svg>",           // OPTIONAL (String) - Inline SVG icon displayed in the group header.
                                               // Rendered as HTML inside .left-pane-group-icon element.
      "defaultExpanded": true,                 // OPTIONAL (Boolean) - Whether this group is expanded on initial load.
                                               // Default: false (collapsed).

      "groupItems": [                          // REQUIRED (Array) - Mixed array of subgroups and/or standalone buttons.
                                               // Subgroups have "subgroupLabel" + "buttons".
                                               // Standalone buttons have "label" + "paramName" (no subgroupLabel).

        // ·····································································
        // SUBGROUP: Product Category (3 alike elements - value prompt with autocomplete)
        // ·····································································
        {
          "subgroupLabel": "Product Category",         // REQUIRED for subgroups (String) - Fallback subgroup header label.
          "subgroupLabels": {                          // OPTIONAL (Object) - Localized subgroup labels.
            "de": "Produktkategorie",
            "en": "Product Category"
          },
          "defaultExpanded": false,                    // OPTIONAL (Boolean) - Whether subgroup is expanded on load. Default: false.

          "buttons": [                                 // REQUIRED (Array) - Buttons within this subgroup.

            // BUTTON: Product Category Level 1 — promptType: "value" (autocomplete via DataStore)
            {
              "label": "Product Category (Level 1)",           // REQUIRED (String) - Fallback button label.
              "labels": {                                      // OPTIONAL (Object) - Localized button labels.
                "de": "Produktkategorie (Ebene 1)",
                "en": "Product Category (Level 1)"
              },
              "tooltip": "Select top-level product category",  // OPTIONAL (String) - Fallback tooltip on hover.
              "tooltips": {                                    // OPTIONAL (Object) - Localized tooltips.
                "de": "Produktkategorie der obersten Ebene auswählen",
                "en": "Select top-level product category"
              },
              "paramName": "P_ProdCat_L1",                    // REQUIRED (String) - Cognos parameter name to populate.
                                                               // Must match the report's parameter exactly.
              "promptType": "value",                           // OPTIONAL (String) - Explicit value prompt type.
                                                               // Renders bubble input with autocomplete (if queryName is set).
                                                               // Equivalent to omitting promptType; used for clarity.
              "queryName": "qp_ProdCat_L1",                   // OPTIONAL (String) - Name of the DataStore query providing
                                                               // autocomplete values. Omit for manual-only input.
              "useColumn": 0,                                  // OPTIONAL (Integer) - Column index in query results for the
                                                               // "use" value (sent to Cognos). Default: 0.
              "displayColumn": 1,                              // OPTIONAL (Integer) - Column index for the "display" value
                                                               // (shown to user). Default: same as useColumn.
              "required": true,                                // OPTIONAL (Boolean) - If true, card auto-renders on load
                                                               // and cannot be removed. Shows required indicator.
              "helpText": "Required: Select at least one product category",  // OPTIONAL (String) - Fallback help text shown on the card.
              "helpTexts": {                                   // OPTIONAL (Object) - Localized help texts.
                "de": "Erforderlich: Mindestens eine Produktkategorie auswählen",
                "en": "Required: Select at least one product category"
              }
            },

            // BUTTON: Product Category Level 2 — promptType: "value"
            {
              "label": "Product Category (Level 2)",
              "labels": {
                "de": "Produktkategorie (Ebene 2)",
                "en": "Product Category (Level 2)"
              },
              "tooltip": "Select mid-level product category",
              "tooltips": {
                "de": "Produktkategorie der mittleren Ebene auswählen",
                "en": "Select mid-level product category"
              },
              "paramName": "P_ProdCat_L2",
              "promptType": "value",
              "queryName": "qp_ProdCat_L2",
              "useColumn": 0,
              "displayColumn": 1,
              "helpText": "Select from dropdown or type to filter",
              "helpTexts": {
                "de": "Aus Dropdown wählen oder tippen zum Filtern",
                "en": "Select from dropdown or type to filter"
              }
            },

            // BUTTON: Product Category Level 3 — promptType: "value"
            {
              "label": "Product Category (Level 3)",
              "labels": {
                "de": "Produktkategorie (Ebene 3)",
                "en": "Product Category (Level 3)"
              },
              "tooltip": "Select detailed product category",
              "tooltips": {
                "de": "Detaillierte Produktkategorie auswählen",
                "en": "Select detailed product category"
              },
              "paramName": "P_ProdCat_L3",
              "promptType": "value",
              "queryName": "qp_ProdCat_L3",
              "useColumn": 0,
              "displayColumn": 1,
              "helpText": "Select from dropdown or type to filter",
              "helpTexts": {
                "de": "Aus Dropdown wählen oder tippen zum Filtern",
                "en": "Select from dropdown or type to filter"
              }
            }
          ]
        },

        // ·····································································
        // STANDALONE BUTTON: Order Date (Range) — promptType: "dateRange"
        // Uses in_range() — single parameter with start/end structure
        // ·····································································
        {
          "label": "Order Date (Range)",
          "labels": {
            "de": "Bestelldatum (Bereich)",
            "en": "Order Date (Range)"
          },
          "tooltip": "Select order date range - uses in_range()",
          "tooltips": {
            "de": "Bestelldatumsbereich auswählen - verwendet in_range()",
            "en": "Select order date range - uses in_range()"
          },
          "paramName": "P_OrderDateRange",                     // REQUIRED (String) - Single parameter receiving the range.
          "promptType": "dateRange",                           // REQUIRED for this type (String) - Renders FROM/TO date pickers.
                                                               // getParameters() returns: { start: {use, display}, end: {use, display} }
          "dateFormat": "yyyy-MM-dd",                          // OPTIONAL (String) - Informational hint for expected date format.
          "helpText": "Uses in_range() filter - single parameter with start/end dates",
          "helpTexts": {
            "de": "Verwendet in_range() Filter - einzelner Parameter mit Start-/Enddatum",
            "en": "Uses in_range() filter - single parameter with start/end dates"
          }
        },

        // ·····································································
        // STANDALONE BUTTON: Order Date (From/To) — promptType: "dateFromTo"
        // Uses BETWEEN — two separate parameters for FROM and TO
        // ·····································································
        {
          "label": "Order Date (From/To)",
          "labels": {
            "de": "Bestelldatum (Von/Bis)",
            "en": "Order Date (From/To)"
          },
          "tooltip": "Select order date range - uses BETWEEN with separate FROM/TO params",
          "tooltips": {
            "de": "Bestelldatumsbereich auswählen - verwendet BETWEEN mit separaten VON/BIS Parametern",
            "en": "Select order date range - uses BETWEEN with separate FROM/TO params"
          },
          "promptType": "dateFromTo",                          // REQUIRED for this type (String) - Renders FROM/TO date pickers.
                                                               // getParameters() returns TWO separate parameter objects.
          "paramNames": {                                      // REQUIRED for dateFromTo (Object) - Two parameter names.
            "from": "P_OrderDateFrom",                         // REQUIRED (String) - Parameter for the start date.
            "to": "P_OrderDateTo"                              // REQUIRED (String) - Parameter for the end date.
          },
          "dateFormat": "yyyy-MM-dd",
          "helpText": "Uses BETWEEN filter - two separate parameters for start and end",
          "helpTexts": {
            "de": "Verwendet BETWEEN Filter - zwei separate Parameter für Start und Ende",
            "en": "Uses BETWEEN filter - two separate parameters for start and end"
          }
          // NOTE: No "paramName" here — dateFromTo uses "paramNames" (plural) instead.
        },

        // ·····································································
        // STANDALONE BUTTON: Shipping Date — promptType: "date"
        // Single date picker, single value
        // ·····································································
        {
          "label": "Shipping Date",
          "labels": {
            "de": "Versanddatum",
            "en": "Shipping Date"
          },
          "tooltip": "Select a single shipping date",
          "tooltips": {
            "de": "Ein einzelnes Versanddatum auswählen",
            "en": "Select a single shipping date"
          },
          "paramName": "P_ShipDate",                           // REQUIRED (String) - Cognos parameter name.
          "promptType": "date",                                // REQUIRED for this type (String) - Renders a single date picker.
                                                               // getParameters() returns one value with use/display from the date input.
          "dateFormat": "yyyy-MM-dd",
          "helpText": "Select a single date value",
          "helpTexts": {
            "de": "Einen einzelnen Datumswert auswählen",
            "en": "Select a single date value"
          }
        }
      ]
    },

    // ─────────────────────────────────────────────────────────────────────────
    // GROUP 2: Customer Complaints (CC)
    // Contains: 2 standalone buttons (searchSelect + text)
    // ─────────────────────────────────────────────────────────────────────────
    {
      "groupLabel": "Customer Complaints (CC)",
      "groupLabels": {
        "de": "Kundenbeschwerden (KB)",
        "en": "Customer Complaints (CC)"
      },
      "groupIcon": "<svg>...</svg>",
      "defaultExpanded": false,

      "groupItems": [

        // ·····································································
        // BUTTON: Customer Number — promptType: "searchSelect"
        // On-demand search for large datasets (2000+ values)
        // ·····································································
        {
          "label": "Customer Number",
          "labels": {
            "de": "Kundennummer",
            "en": "Customer Number"
          },
          "tooltip": "Search customer by number - on-demand search",
          "tooltips": {
            "de": "Kunde nach Nummer suchen - On-Demand-Suche",
            "en": "Search customer by number - on-demand search"
          },
          "paramName": "P_CustomerNR",                         // REQUIRED (String) - Cognos parameter name.
          "promptType": "searchSelect",                        // REQUIRED for this type (String) - Enables on-demand search UI.
                                                               // Delegates search to a hidden native Cognos Search & Select prompt.
          "sspBlockName": "b_SSP_CustNR",                     // REQUIRED for searchSelect (String) - The "lid" of the hidden
                                                               // Cognos block containing the native Search & Select prompt.
                                                               // Must match the Block name in the report layout.
          "useValueLength": 4,                                 // OPTIONAL (Integer) - Number of leading characters from the
                                                               // result string used as the "use" value.
                                                               // If omitted, the full result string is used.
          "required": true,
          "helpText": "Type customer number and press ENTER to search",
          "helpTexts": {
            "de": "Kundennummer eingeben und ENTER drücken zum Suchen",
            "en": "Type customer number and press ENTER to search"
          }
        },

        // ·····································································
        // BUTTON: Complaint Reference — promptType: "text"
        // Pure manual entry, no autocomplete, no query
        // ·····································································
        {
          "label": "Complaint Reference",
          "labels": {
            "de": "Beschwerdereferenz",
            "en": "Complaint Reference"
          },
          "tooltip": "Enter complaint reference number(s) manually",
          "tooltips": {
            "de": "Beschwerdereferenznummer(n) manuell eingeben",
            "en": "Enter complaint reference number(s) manually"
          },
          "paramName": "P_ComplaintRef",                       // REQUIRED (String) - Cognos parameter name.
          "promptType": "text",                                // OPTIONAL (String) - Explicit text-only input.
                                                               // Renders bubble input without autocomplete.
                                                               // Functionally similar to omitting queryName,
                                                               // but signals intent clearly in configuration.
          "helpText": "Manual entry - type value and press ENTER",
          "helpTexts": {
            "de": "Manuelle Eingabe - Wert eingeben und ENTER drücken",
            "en": "Manual entry - type value and press ENTER"
          }
        }
      ]
    }
  ]
}
